{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shodan CVEDB Account Directory API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Directory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Saved Queries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cvedb.shodan.io/shodan/query",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Browse the directory of community-saved Shodan queries."
        },
        {
          "info": {
            "name": "Search Saved Queries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cvedb.shodan.io/shodan/query/search",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Shodan search query."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search the directory of saved Shodan queries."
        },
        {
          "info": {
            "name": "List Popular Query Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cvedb.shodan.io/shodan/query/tags",
            "params": [
              {
                "name": "size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the most popular tags assigned to saved queries."
        }
      ]
    }
  ],
  "bundled": true
}